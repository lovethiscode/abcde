{
  "scale": [0.125],
  "maxWidth": 1024,
  "maxHeight": 1024,
  "paddingX": 8,
  "paddingY": 8,
  "duplicatePadding": true,
  "combineSubdirectories": true,
  "stripWhitespaceX": false,
  "stripWhitespaceY": false,
  "rotation": false,
  "filterMin": "MipMapLinearLinear",
  "filterMag": "Linear",
  "premultiplyAlpha": false
}
