<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21507" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="landscape" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21507"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="expedition-launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="852" height="393"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="ExtraImages/LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="launch-background"/>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="ExtraImages/LaunchMarkTransparent" translatesAutoresizingMaskIntoConstraints="NO" id="launch-mark">
                                <constraints>
                                    <constraint firstAttribute="width" priority="750" constant="252" id="mark-width"/>
                                    <constraint firstAttribute="width" secondItem="launch-mark" secondAttribute="height" multiplier="1:1" id="mark-aspect"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" red="0.0901960784" green="0.2039215686" blue="0.2470588235" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="launch-background" firstAttribute="leading" secondItem="launch-view" secondAttribute="leading" id="background-leading"/>
                            <constraint firstItem="launch-background" firstAttribute="trailing" secondItem="launch-view" secondAttribute="trailing" id="background-trailing"/>
                            <constraint firstItem="launch-background" firstAttribute="top" secondItem="launch-view" secondAttribute="top" id="background-top"/>
                            <constraint firstItem="launch-background" firstAttribute="bottom" secondItem="launch-view" secondAttribute="bottom" id="background-bottom"/>
                            <constraint firstItem="launch-mark" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="mark-center-x"/>
                            <constraint firstItem="launch-mark" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" id="mark-center-y"/>
                            <constraint firstItem="launch-mark" firstAttribute="width" relation="lessThanOrEqual" secondItem="launch-view" secondAttribute="width" multiplier="0.8" id="mark-max-width"/>
                            <constraint firstItem="launch-mark" firstAttribute="height" relation="lessThanOrEqual" secondItem="launch-view" secondAttribute="height" multiplier="0.72" id="mark-max-height"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="ExtraImages/LaunchBackground" width="1024" height="512"/>
        <image name="ExtraImages/LaunchMarkTransparent" width="252" height="252"/>
    </resources>
</document>
