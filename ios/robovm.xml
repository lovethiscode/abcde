<config>
    <executableName>${app.executable}</executableName>
    <mainClass>${app.mainclass}</mainClass>
    <os>ios</os>
    <arch>arm64</arch>
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>
    <resources>
        <resource>
            <directory>../android/assets</directory>
            <includes>
                <include>**</include>
            </includes>
            <skipPngCrush>true</skipPngCrush>
        </resource>
        <resource>
            <directory>data</directory>
            <skipPngCrush>true</skipPngCrush>
        </resource>
        <resource>
            <directory>app-store-resources</directory>
            <excludes>
                <!-- Static ObjectAL uses the same declarations in the app privacy manifest. -->
                <exclude>Frameworks/ObjectAL.framework/**</exclude>
            </excludes>
        </resource>
        <resource>
            <directory>build/default/generated/app-store-icon</directory>
            <includes>
                <include>Assets.car</include>
                <include>AppIcon60x60@2x.png</include>
                <include>AppIcon76x76@2x~ipad.png</include>
            </includes>
        </resource>
        <resource>
            <directory>build/default/generated/launch-screen</directory>
            <includes><include>AppIconLaunchScreen.storyboardc/**</include></includes>
        </resource>
    </resources>
    <forceLinkClasses>
        <pattern>com.unciv.logic.campaign.**</pattern>
        <pattern>com.unciv.logic.endless.**</pattern>
        <pattern>com.badlogic.gdx.backends.iosrobovm.IOSApplication$SceneDelegate</pattern>
        <pattern>com.badlogic.gdx.scenes.scene2d.ui.**</pattern>
        <pattern>com.android.org.conscrypt.**</pattern>
        <pattern>kotlinx.serialization.**</pattern>
        <pattern>org.apache.harmony.security.provider.crypto.**</pattern>
    </forceLinkClasses>
    <frameworkPaths>
        <path platform="ios" variant="device" arch="arm64">build/default/generated/gdx-framework/ios-arm64</path>
        <path platform="ios" variant="simulator">build/default/generated/gdx-framework/ios-arm64_x86_64-simulator</path>
    </frameworkPaths>
    <frameworks>
        <framework>gdx</framework>
        <framework>UIKit</framework>
        <framework>QuartzCore</framework>
        <framework>CoreGraphics</framework>
        <framework>CoreText</framework>
        <framework>OpenAL</framework>
        <framework>AudioToolbox</framework>
        <framework>AVFoundation</framework>
        <framework>Security</framework>
    </frameworks>
</config>
